# Database
# DATABASE_URL is stitched from POSTGRES_* when not set. Override DATABASE_URL
# only when you need a non-stitchable URL (e.g. a hosted Postgres with TLS).
POSTGRES_USER=company_ai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=company_ai
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL=

# LLM (OpenAI-compatible: OpenRouter, vLLM, OpenAI, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-3-12b-it
LLM_REASONING_EFFORT=low
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1536

# Sovereign deployment (vLLM) — used by deploy/vllm/
LLM_MODEL_VLLM=google/gemma-3-12b-it

# Application
APP_TITLE=The Company Knowledge AI
HTTP_REFERER=
LOG_LEVEL=INFO
LOG_COLOR=false

# Session
SESSION_COOKIE_NAME=company_ai_session
SESSION_TTL_DAYS=7
SESSION_SECRET=change-me-to-a-long-random-string

# Rate limiting and budget
RATE_LIMIT_PER_IP_PER_MINUTE=20
RATE_LIMIT_PER_SESSION_PER_HOUR=50
DAILY_TOKEN_BUDGET=1500000
